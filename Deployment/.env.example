NODE_ENV=production
# Leave PORT unset in Passenger; the host manages it.
# Paste your complete Atlas URI here, replacing username/password placeholders.
# Do not use localhost unless MongoDB is installed on your cPanel server.
# Quote the value in .env. cPanel environment values should have no surrounding quotes.
MONGODB_URI=
CLIENT_URL=https://jmdschool.com,http://jmdschool.com
JWT_SECRET=
JWT_EXPIRE=1d
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional SMS delivery; email is required for registration.
SMS_BD_API_KEY=
SMS_BD_SENDER_ID=
# Set only to the actual trusted proxy IPs/CIDRs provided by your host.
# TRUST_PROXY=127.0.0.1/8,::1/128
# Temporary first administrator bootstrap values; remove after use.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
