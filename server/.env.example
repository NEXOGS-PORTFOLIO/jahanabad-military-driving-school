NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/jmds_tms
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE=30d
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USER=info@example.com
EMAIL_PASS=
# Optional sender address if the SMTP login username is not an email address.
# EMAIL_FROM=info@example.com
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS.BD API key from the SMS panel (server only).
SMS_BD_API_KEY=
# Optional: an approved masking sender ID from your SMS.BD account.
SMS_BD_SENDER_ID=

# Certificate numbering uses the calendar year in this timezone.
CERTIFICATE_SERIAL_START=404
CERTIFICATE_TIME_ZONE=Asia/Dhaka

